# Variables de Entorno - Inventario ESCS v3.0
# Copiar este archivo a .env y ajustar los valores

# ==========================================
# CONFIGURACIÓN DEL SERVIDOR
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (SQL Server)
# ==========================================
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=InventarioESCS
DB_USER=inventario_user
DB_PASSWORD=TuPasswordSeguro123!
DB_ENCRYPT=false
DB_TRUST_CERT=true

# ==========================================
# SEGURIDAD Y AUTENTICACIÓN
# ==========================================
JWT_SECRET=TU_CLAVE_SECRETA_MUY_SEGURA_CAMBIAR_EN_PRODUCCION_abc123xyz789
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# ==========================================
# CONFIGURACIÓN DE ARCHIVOS
# ==========================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif

# ==========================================
# CORS
# ==========================================
CORS_ORIGIN=http://localhost:3000

# ==========================================
# LOGS
# ==========================================
LOG_LEVEL=info
LOG_DIR=./logs

# ==========================================
# CONFIGURACIÓN IIS (Producción)
# ==========================================
IIS_ENABLED=false
IIS_PORT=8080
