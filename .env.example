# Variables de entorno para Docker Compose
# Copiar este archivo a .env y ajustar los valores

# ==========================================
# CONFIGURACIÓN DE LA BASE DE DATOS
# ==========================================
DB_SA_PASSWORD=YourStrong@Passw0rd!

# ==========================================
# SEGURIDAD JWT
# ==========================================
# Cambiar por una clave única y segura en producción
JWT_SECRET=cambia_esto_por_una_clave_muy_segura_en_produccion_12345

# ==========================================
# CORS (opcional, por defecto *)
# ==========================================
CORS_ORIGIN=*

# ==========================================
# PUERTOS (opcional)
# ==========================================
# HTTP_PORT=80
# DB_PORT=1433


# ==========================================
# PUERTO DE LA APLICACIÓN (frontend)
# ==========================================
# Cambiar si el puerto 80 está ocupado en el servidor
# Por defecto usa 8080 para evitar conflictos
APP_PORT=8080
